# Application Ports
PORT=5000
APP_URL=http://localhost:3000

# PostgreSQL Configuration
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_NAME=authdb

# Redis Configuration (Mandatory)
REDIS_URL=redis://redis:6379
VERIFICATION_TOKEN_TTL=900

# Security
JWT_SECRET=super_secret_jwt_key_for_beginner_auth

# Optional SMTP Email Configuration (If omitted, simulated links are printed in Docker console & shown in UI)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@authapp.local
